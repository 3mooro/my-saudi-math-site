---
import { getCollection } from 'astro:content';
import { env } from 'cloudflare:workers';

let studentsCount = 0;
let coursesCount = 0;
let teachersCount = 0;

try {
	const db = env.DB;
	if (db) {
		const s = await db.prepare("SELECT COUNT(*) as count FROM student_accounts").first();
		if (s && s.count !== undefined) studentsCount = Number(s.count);
		
		const c = await db.prepare("SELECT COUNT(*) as count FROM courses").first();
		if (c && c.count !== undefined) coursesCount = Number(c.count);
		
		const t = await db.prepare("SELECT COUNT(*) as count FROM teachers").first();
		if (t && t.count !== undefined) teachersCount = Number(t.count);
	}
} catch (e) {
	console.error("Failed to fetch stats from DB:", e);
}

const allStats = await getCollection('stats');
const stats = allStats
	.map(s => {
		let val = s.data.value;
		if (s.data.label.includes('طالب')) val = `+${(studentsCount + 500).toLocaleString()}`;
		if (s.data.label.includes('كورس')) val = `+${(coursesCount + 10).toLocaleString()}`;
		if (s.data.label.includes('معلم') || s.data.label.includes('أداة') || s.data.label.includes('خبرة')) val = `+${(teachersCount + 5).toLocaleString()}`;
		return { ...s.data, value: val };
	})
	.sort((a, b) => a.order - b.order);
---
<section id="stats-section" class="py-16 md:py-24 border-y bg-muted/20 relative overflow-hidden">
	<div class="container mx-auto px-4">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
			{stats.map((stat) => (
				<div class="text-center space-y-3 group reveal flex flex-col items-center">
					<div class="w-16 h-16 rounded-2xl bg-card shadow-sm flex items-center justify-center text-4xl mb-2 group-hover:scale-110 transition-transform duration-500">
						{stat.icon}
					</div>
					<div class="space-y-1">
						<div class="text-4xl md:text-6xl font-black font-cairo text-foreground tabular-nums flex justify-center items-baseline gap-1">
							<span class="stat-value" data-target={stat.value.replace(/[^0-9]/g, '')}>
								{stat.value.replace(/[^0-9]/g, '')}
							</span>
							<span class="text-primary text-2xl md:text-3xl">{stat.value.replace(/[0-9]/g, '')}</span>
						</div>
						<div class="text-sm md:text-base text-muted-foreground font-black tracking-widest uppercase">{stat.label}</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const startCounter = (el: HTMLElement) => {
		const target = parseInt(el.dataset.target || '0');
		if (isNaN(target)) return;
		
		let count = 0;
		const duration = 2000;
		const increment = target / (duration / 16);

		const update = () => {
			count += increment;
			if (count < target) {
				el.innerText = Math.floor(count).toLocaleString();
				requestAnimationFrame(update);
			} else {
				el.innerText = target.toLocaleString();
			}
		};
		update();
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				const counters = entry.target.querySelectorAll('.stat-value');
				counters.forEach(c => startCounter(c as HTMLElement));
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.2 });

	const section = document.getElementById('stats-section');
	if (section) observer.observe(section);
</script>
