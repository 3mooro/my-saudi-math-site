---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Font } from 'astro:assets';

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	title: string;
	description: string;
	image?: string | ImageMetadata;
	type?: 'website' | 'article' | 'course';
	articleDate?: Date;
	author?: string;
	keywords?: string;
	breadcrumbs?: BreadcrumbItem[];
	faqList?: FAQItem[];
	courseInstructor?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { 
	title, 
	description, 
	image = '/blog-placeholder-1.jpg',
	type = 'website',
	articleDate,
	author = 'أكاديمية KSA',
	keywords = 'المناهج السعودية, منصة تعليمية سعودية, دروس خصوصية اونلاين, مدرس خصوصي المنهج السعودي, اختبار القدرات, تجميعات قدرات, التحصيلي, رياضيات المنهج السعودي, فيزياء, كيمياء, لغتي, مراجعات واختبارات, أكاديمية KSA, حصة تجريبية, معلمين خصوصيين',
	breadcrumbs,
	faqList,
	courseInstructor = 'أكاديمية KSA'
} = Astro.props;

// Handle image URL resolution
const resolvedImageSrc = typeof image === 'string' ? image : image?.src;
const imageURL = new URL(resolvedImageSrc || '/blog-placeholder-1.jpg', Astro.url);

// JSON-LD Schema Graph Generation
const schemaGraph: any[] = [
	{
		"@type": "EducationalOrganization",
		"@id": `${Astro.site}#organization`,
		"name": "أكاديمية KSA التعليمية",
		"alternateName": "KSA Academy",
		"url": String(Astro.site),
		"logo": new URL('/favicon.svg', Astro.site).href,
		"description": "المنصة التعليمية الرائدة في المملكة العربية السعودية لشرح المناهج الدراسية، تأسيس القدرات والتحصيلي، والدروس الخصوصية المباشرة لجميع المراحل.",
		"sameAs": [
			"https://twitter.com/ksaacademy",
			"https://instagram.com/ksaacademy",
			"https://linkedin.com/company/ksaacademy"
		],
		"address": {
			"@type": "PostalAddress",
			"addressCountry": "SA"
		}
	},
	{
		"@type": "WebSite",
		"@id": `${Astro.site}#website`,
		"url": String(Astro.site),
		"name": SITE_TITLE,
		"description": SITE_DESCRIPTION,
		"publisher": {
			"@id": `${Astro.site}#organization`
		},
		"inLanguage": "ar-SA"
	}
];

if (type === 'article') {
	schemaGraph.push({
		"@type": "Article",
		"@id": `${canonicalURL.href}#article`,
		"isPartOf": {
			"@id": `${Astro.site}#website`
		},
		"headline": title,
		"description": description,
		"url": canonicalURL.href,
		"image": imageURL.href,
		"datePublished": articleDate ? articleDate.toISOString() : undefined,
		"dateModified": articleDate ? articleDate.toISOString() : undefined,
		"author": {
			"@type": "Person",
			"name": author
		},
		"publisher": {
			"@id": `${Astro.site}#organization`
		},
		"inLanguage": "ar-SA"
	});
} else if (type === 'course') {
	schemaGraph.push({
		"@type": "Course",
		"@id": `${canonicalURL.href}#course`,
		"name": title,
		"description": description,
		"url": canonicalURL.href,
		"image": imageURL.href,
		"provider": {
			"@id": `${Astro.site}#organization`
		},
		"instructor": {
			"@type": "Person",
			"name": courseInstructor
		},
		"inLanguage": "ar-SA"
	});
}

// Add BreadcrumbList schema if provided
if (breadcrumbs && breadcrumbs.length > 0) {
	schemaGraph.push({
		"@type": "BreadcrumbList",
		"@id": `${canonicalURL.href}#breadcrumb`,
		"itemListElement": breadcrumbs.map((item, index) => ({
			"@type": "ListItem",
			"position": index + 1,
			"name": item.name,
			"item": item.url.startsWith('http') ? item.url : new URL(item.url, Astro.site).href
		}))
	});
}

// Add FAQPage schema if provided
if (faqList && faqList.length > 0) {
	schemaGraph.push({
		"@type": "FAQPage",
		"@id": `${canonicalURL.href}#faq`,
		"mainEntity": faqList.map((faq) => ({
			"@type": "Question",
			"name": faq.question,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": faq.answer
			}
		}))
	});
}

const finalSchema = {
	"@context": "https://schema.org",
	"@graph": schemaGraph
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-cairo" preload />
<Font cssVariable="--font-tajawal" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:locale" content="ar_SA" />
<meta property="og:site_name" content="أكاديمية KSA" />
{type === 'article' && articleDate && (
	<meta property="article:published_time" content={articleDate.toISOString()} />
	<meta property="article:author" content={author} />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL.href} />

<!-- JSON-LD Structured Data for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

<!-- OneSignal Push Notifications -->
<script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
<script>
  // Get external ID from cookies (client-side approach to avoid SSR caching issues if any)
  const getCookie = (name) => {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
  };
  
  const studentAuth = getCookie('student_auth');
  const teacherAuth = getCookie('teacher_auth');
  let externalId = null;
  
  if (teacherAuth) {
    externalId = `teacher_${teacherAuth}`;
  } else if (studentAuth) {
    externalId = `student_${studentAuth}`;
  }

  window.OneSignalDeferred = window.OneSignalDeferred || [];
  OneSignalDeferred.push(async function(OneSignal) {
    await OneSignal.init({
      appId: "d6d3c46f-3d7f-4f60-a826-2184d73cc8d3",
    });
    
    if (externalId) {
      OneSignal.login(externalId);
    } else {
      OneSignal.logout();
    }
  });
</script>
