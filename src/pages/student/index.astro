---
export const prerender = false;
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { env } from 'cloudflare:workers';

const authCookie = Astro.cookies.get('student_auth')?.value;
if (!authCookie) {
  return Astro.redirect('/login');
}

const db = env.DB;
let student: any = null;
let subscriptions: any[] = [];
let courses: any[] = [];
let schedules: any[] = [];

if (db) {
  try {
    student = await db.prepare('SELECT * FROM student_accounts WHERE id = ?').bind(authCookie).first();
    if (!student) {
      Astro.cookies.delete('student_auth');
      return Astro.redirect('/login');
    }

    const subsResult = await db.prepare("SELECT cs.*, t.name as teacher_name, (SELECT COUNT(*) FROM chat_messages WHERE receiver_id = cs.id AND sender_type = 'teacher' AND is_read = 0) as unread_count FROM course_subscriptions cs LEFT JOIN teachers t ON cs.teacher_id = t.id WHERE cs.student_id = ? ORDER BY cs.created_at DESC").bind(student.id).all();
    subscriptions = subsResult.results || [];

    const schedulesResult = await db.prepare(`
      SELECT cs.*, t.name as teacher_name 
      FROM class_schedules cs 
      JOIN teachers t ON cs.teacher_id = t.id 
      WHERE cs.student_id = ? AND cs.status = 'scheduled'
      ORDER BY cs.scheduled_at ASC
    `).bind(student.id).all();
    schedules = schedulesResult.results || [];

    // Get available courses for the dropdown (assuming we have a courses table, or we just use static list)
    // Actually we'll just use a static list for now or fetch from Astro collections.
  } catch (e) {
    console.error(e);
  }
} else {
  // Mock data for local dev
  student = { name: 'طالب تجريبي', phone: '0500000000' };
  subscriptions = [
    { id: 1, course_name: 'رياضيات اول ثانوي', package_name: '8 حصص', remaining_sessions: 6, status: 'active', teacher_name: 'أحمد محمود' },
    { id: 2, course_name: 'فيزياء', package_name: 'حصص عاجلة', remaining_sessions: 0, status: 'pending', teacher_name: null }
  ];
}

const success = Astro.url.searchParams.get('success');
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
	<head>
		<BaseHead title={`حسابي - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-background text-foreground flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-1 container mx-auto px-4 py-12">
      <div class="flex justify-between items-center mb-10">
        <div>
          <h1 class="text-3xl md:text-4xl font-black font-cairo text-gradient">مرحباً، {student?.name}</h1>
          <p class="text-muted-foreground mt-2 font-bold">{student?.phone}</p>
        </div>
        <a href="/api/auth/student-logout" class="bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-900/20 dark:text-red-400 px-4 py-2 rounded-xl font-bold transition-colors">تسجيل الخروج</a>
      </div>

      {success === 'subscribed' && (
        <div class="bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 p-4 rounded-xl mb-8 font-bold text-center border border-green-200 dark:border-green-800">
          تم إرسال طلب الاشتراك بنجاح! سيتم التواصل معك لتأكيد الاشتراك وتعيين المعلم.
        </div>
      )}

      <div class="grid md:grid-cols-3 gap-8">
        <div class="md:col-span-2 space-y-6">
          <h2 class="text-2xl font-black font-cairo mb-4 border-b pb-4">كورساتي واشتراكاتي</h2>
          
          {subscriptions.length === 0 ? (
            <div class="text-center py-12 bg-card rounded-3xl border border-dashed">
              <p class="text-muted-foreground font-bold text-lg mb-4">ليس لديك أي اشتراكات حالياً</p>
            </div>
          ) : (
            <div class="grid gap-4">
              {subscriptions.map(sub => (
                <div class="bg-card border rounded-2xl p-6 shadow-sm flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
                  <div>
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="text-xl font-black">{sub.course_name}</h3>
                      {sub.status === 'pending' ? (
                        <span class="bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300 text-xs px-2 py-1 rounded-md font-bold">قيد المراجعة</span>
                      ) : (
                        <span class="bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 text-xs px-2 py-1 rounded-md font-bold">نشط</span>
                      )}
                    </div>
                    <p class="text-sm text-muted-foreground font-bold">
                      الباقة: <span class="text-primary">{sub.package_name}</span> 
                      {sub.teacher_name && <span> | المعلم: {sub.teacher_name}</span>}
                    </p>
                  </div>
                  
                  {sub.status === 'active' && (
                    <div class="flex gap-4 items-center">
                      {sub.discount_note && (
                        <div class="bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 px-4 py-2 rounded-xl text-sm font-bold border border-green-200 dark:border-green-800">
                          {sub.discount_note}
                        </div>
                      )}
                      {sub.teacher_id && (
                        <a href={`/chat/${sub.id}`} class="relative bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 px-4 py-2 rounded-xl text-sm font-bold border border-blue-200 dark:border-blue-800 flex items-center gap-2 hover:bg-blue-200 transition-colors whitespace-nowrap">
                          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                          محادثة
                          {sub.unread_count > 0 && (
                            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs w-5 h-5 flex items-center justify-center rounded-full animate-bounce">{sub.unread_count}</span>
                          )}
                        </a>
                      )}
                      <div class="bg-primary/10 text-primary px-6 py-3 rounded-xl text-center min-w-[120px]">
                        <span class="block text-sm font-bold opacity-80">الحصص المتبقية</span>
                        <span class="block text-2xl font-black font-cairo">{sub.remaining_sessions}</span>
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>

        <div>
          <div class="bg-card border rounded-3xl p-6 shadow-xl shadow-primary/5 sticky top-24">
            <h3 class="text-xl font-black font-cairo mb-6">اشتراك في كورس جديد</h3>
            
            <form action="/api/student/subscribe" method="POST" class="space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-bold mb-2">المرحلة</label>
                  <select name="stage" id="level_select" required class="w-full bg-background border border-input rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="" disabled selected>اختر المرحلة...</option>
                    <option value="ابتدائي">ابتدائي</option>
                    <option value="متوسط">متوسط</option>
                    <option value="ثانوي">ثانوي</option>
                    <option value="جامعي">جامعي (قدرات وتحصيلي)</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-bold mb-2">الصف الدراسي</label>
                  <select name="grade" id="grade_select" required disabled class="w-full bg-background border border-input rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50">
                    <option value="" disabled selected>اختر الصف...</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold mb-2">اختر المادة</label>
                <select name="course_name" id="course_select" required disabled class="w-full bg-background border border-input rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50">
                  <option value="" disabled selected>اختر المادة...</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-bold mb-2">اختر الباقة</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                  <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer hover:bg-accent transition-colors">
                    <input type="radio" name="package_name" value="باقة 12 حصة" required class="text-primary focus:ring-primary w-4 h-4" />
                    <div>
                      <span class="block font-bold">باقة 12 حصة</span>
                      <span class="block text-xs text-muted-foreground">3 حصص أسبوعياً</span>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer hover:bg-accent transition-colors">
                    <input type="radio" name="package_name" value="باقة 8 حصص" required class="text-primary focus:ring-primary w-4 h-4" />
                    <div>
                      <span class="block font-bold">باقة 8 حصص</span>
                      <span class="block text-xs text-muted-foreground">حصتين أسبوعياً</span>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer hover:bg-accent transition-colors">
                    <input type="radio" name="package_name" value="باقة حصتين" required class="text-primary focus:ring-primary w-4 h-4" />
                    <div>
                      <span class="block font-bold">باقة حصتين</span>
                      <span class="block text-xs text-muted-foreground">شرح وحدة محددة</span>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer hover:bg-accent transition-colors">
                    <input type="radio" name="package_name" value="حصة طارئة" required class="text-primary focus:ring-primary w-4 h-4" />
                    <div>
                      <span class="block font-bold">حصة طارئة</span>
                      <span class="block text-xs text-muted-foreground">مراجعة ليلة الاختبار</span>
                    </div>
                  </label>
                </div>
              </div>

              <button type="submit" class="w-full bg-primary text-primary-foreground font-bold py-3 rounded-xl mt-4 hover:bg-primary/90 transition-colors">
                طلب اشتراك
              </button>
            </form>
          </div>
        </div>
      </div>

      {schedules.length > 0 && (
        <div class="mt-12">
          <h2 class="text-2xl font-black font-cairo mb-6 border-b pb-4">مواعيد حصصك القادمة</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {schedules.map(sch => (
              <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-2xl p-4 flex justify-between items-center">
                <div>
                  <p class="font-bold text-blue-900 dark:text-blue-300">أستاذ: {sch.teacher_name}</p>
                  <p class="text-sm font-bold text-blue-700 dark:text-blue-400 mt-1 scheduled-time" data-utc={sch.scheduled_at}></p>
                </div>
                <a href={`/chat/${sch.subscription_id}`} class="bg-blue-600 text-white p-2 rounded-lg hover:bg-blue-700 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                </a>
              </div>
            ))}
          </div>
        </div>
      )}
		</main>

		<Footer />
    <script>
      const coursesByLevel: Record<string, string[]> = {
        'ابتدائي': ['رياضيات', 'لغتي', 'علوم', 'إنجليزي', 'دراسات إسلامية', 'دراسات اجتماعية'],
        'متوسط': ['رياضيات', 'لغتي', 'علوم', 'إنجليزي', 'دراسات إسلامية', 'دراسات اجتماعية', 'مهارات رقمية'],
        'ثانوي': ['رياضيات', 'فيزياء', 'كيمياء', 'أحياء', 'إنجليزي', 'لغتي', 'مهارات رقمية', 'قدرات كمي', 'قدرات لفظي', 'تحصيلي'],
        'جامعي': ['تفاضل وتكامل', 'جبر خطي', 'فيزياء عامة', 'كيمياء عامة', 'إحصاء', 'أخرى']
      };

      const gradesByLevel: Record<string, string[]> = {
        'ابتدائي': ['الأول الابتدائي', 'الثاني الابتدائي', 'الثالث الابتدائي', 'الرابع الابتدائي', 'الخامس الابتدائي', 'السادس الابتدائي'],
        'متوسط': ['الأول المتوسط', 'الثاني المتوسط', 'الثالث المتوسط'],
        'ثانوي': ['الأول الثانوي', 'الثاني الثانوي', 'الثالث الثانوي'],
        'جامعي': ['السنة التحضيرية', 'مستوى أول', 'مستوى ثاني', 'مستوى ثالث', 'أخرى']
      };

      const levelSelect = document.getElementById('level_select') as HTMLSelectElement;
      const gradeSelect = document.getElementById('grade_select') as HTMLSelectElement;
      const courseSelect = document.getElementById('course_select') as HTMLSelectElement;

      if (levelSelect && courseSelect && gradeSelect) {
        levelSelect.addEventListener('change', (e) => {
          const level = (e.target as HTMLSelectElement).value;
          const courses = coursesByLevel[level] || [];
          const grades = gradesByLevel[level] || [];
          
          // Populate Grades
          gradeSelect.innerHTML = '<option value="" disabled selected>اختر الصف...</option>';
          grades.forEach(grade => {
            const option = document.createElement('option');
            option.value = grade;
            option.textContent = grade;
            gradeSelect.appendChild(option);
          });
          gradeSelect.disabled = false;

          // Populate Courses
          courseSelect.innerHTML = '<option value="" disabled selected>اختر المادة...</option>';
          courses.forEach(course => {
            const option = document.createElement('option');
            option.value = course + ' (' + level + ')';
            option.textContent = course;
            courseSelect.appendChild(option);
          });
          courseSelect.disabled = false;
        });
      }

      // Convert UTC times to Local times dynamically
      document.querySelectorAll('.scheduled-time').forEach(el => {
        const utcTime = el.getAttribute('data-utc');
        if (utcTime) {
          const date = new Date(utcTime);
          el.textContent = date.toLocaleString('ar-EG', { 
            weekday: 'long', 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric', 
            hour: '2-digit', 
            minute: '2-digit' 
          });
        }
      });
    </script>
	</body>
</html>
