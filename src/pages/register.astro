---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
	<head>
		<BaseHead title={`إنشاء حساب جديد - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/css/intlTelInput.css" />
		<style>
			.iti { width: 100%; direction: ltr; }
			.iti__flag { background-image: url("https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/img/flags.png"); }
			@media (min-resolution: 2x) {
				.iti__flag { background-image: url("https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/img/flags@2x.png"); }
			}
			.iti__country-list { text-align: left; direction: ltr; }
		</style>
	</head>
	<body class="bg-background text-foreground flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-1 container mx-auto px-4 py-12 md:py-20 flex items-center justify-center">
			<div class="w-full max-w-lg">
				<div class="text-center mb-10">
					<h1 class="text-3xl md:text-5xl font-black font-cairo text-gradient mb-4">أنشئ حسابك الآن</h1>
					<p class="text-muted-foreground font-bold text-lg">انضم إلينا وابدأ رحلة التفوق مع نخبة من أفضل المعلمين.</p>
				</div>

				{success && (
					<div class="bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 p-6 rounded-2xl mb-8 font-bold border border-green-200 dark:border-green-800 text-center animate-in fade-in slide-in-from-bottom-4 duration-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
						<h3 class="text-xl mb-1 text-green-800 dark:text-green-300">تم إرسال طلبك بنجاح!</h3>
						<p class="text-sm">سنتواصل معك في أقرب وقت لتأكيد تسجيلك وبدء الدراسة.</p>
					</div>
				)}

				{error && (
					<div class="bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 p-4 rounded-2xl mb-8 font-bold border border-red-200 dark:border-red-800 text-center">
						حدث خطأ أثناء إرسال الطلب أو أن رقم الجوال مستخدم بالفعل.
					</div>
				)}

				{!success && (
					<div class="bg-card border rounded-3xl shadow-xl shadow-primary/5 p-6 md:p-10 relative overflow-hidden">
						<!-- Decorative background -->
						<div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
						<div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>

						<form action="/api/auth/student-register" method="POST" class="space-y-6 relative z-10">
							<div>
								<label for="name" class="block text-sm font-bold text-muted-foreground mb-2">الاسم الثلاثي أو اسم ولي الأمر</label>
								<input 
									type="text" 
									id="name" 
									name="name" 
									required 
									class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-sm"
									placeholder="أدخل اسمك الكامل"
								/>
							</div>

							<div>
								<label for="phone" class="block text-sm font-bold text-muted-foreground mb-2">رقم الجوال (للتسجيل والدخول)</label>
								<input 
									type="tel" 
									id="phone" 
									name="phone" 
									required 
									dir="ltr"
									class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold text-left focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-sm"
									placeholder="05XXXXXXXX"
								/>
							</div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="stage" class="block text-sm font-bold text-muted-foreground mb-2">المرحلة الدراسية</label>
                  <select id="stage" name="stage" required class="w-full bg-background border border-input rounded-2xl px-4 py-4 text-base font-bold focus:outline-none focus:ring-2 focus:ring-primary transition-all">
                    <option value="" disabled selected>اختر المرحلة...</option>
                    <option value="الابتدائية">الابتدائية</option>
                    <option value="المتوسطة">المتوسطة</option>
                    <option value="الثانوية">الثانوية</option>
                    <option value="الجامعية">الجامعية</option>
                    <option value="أخرى">أخرى</option>
                  </select>
                </div>
                <div>
                  <label for="grade" class="block text-sm font-bold text-muted-foreground mb-2">الصف الدراسي</label>
                  <input type="text" id="grade" name="grade" required class="w-full bg-background border border-input rounded-2xl px-4 py-4 text-base font-bold focus:outline-none focus:ring-2 focus:ring-primary transition-all" placeholder="مثال: الأول الثانوي" />
                </div>
              </div>

							<div>
								<label for="password" class="block text-sm font-bold text-muted-foreground mb-2">كلمة المرور</label>
								<input 
									type="password" 
									id="password" 
									name="password" 
									required 
									dir="ltr"
									class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold text-left focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-sm"
									placeholder="••••••••"
								/>
							</div>

							<button 
								type="submit" 
								class="w-full bg-primary hover:bg-primary/90 text-primary-foreground font-black text-lg py-4 rounded-2xl shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-1 transition-all duration-300 font-cairo mt-4"
							>
								إنشاء حساب جديد
							</button>

							<p class="text-center text-muted-foreground mt-6 font-bold text-sm">
								لديك حساب بالفعل؟ <a href="/login" class="text-primary hover:underline">تسجيل الدخول</a>
							</p>
						</form>
					</div>
				)}
			</div>
		</main>

		<Footer />

		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/js/intlTelInput.min.js"></script>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				const input = document.querySelector("#phone");
				if(input) {
					const iti = window.intlTelInput(input, {
						utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/js/utils.js",
						initialCountry: "sa",
						preferredCountries: ["sa", "eg", "ae", "kw", "qa", "bh", "om"],
						separateDialCode: true,
					});

					const form = input.closest('form');
					if(form) {
						form.addEventListener("submit", function(e) {
							if (!iti.isValidNumber()) {
								e.preventDefault();
								alert("رقم الجوال المدخل غير صحيح، يرجى التأكد منه وإعادة المحاولة.");
								return;
							}
							const hiddenPhone = document.createElement("input");
							hiddenPhone.type = "hidden";
							hiddenPhone.name = "phone";
							hiddenPhone.value = iti.getNumber();
							input.removeAttribute("name");
							this.appendChild(hiddenPhone);
						});
					}
				}
			});
		</script>
	</body>
</html>
