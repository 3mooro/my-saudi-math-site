---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
	<head>
		<BaseHead title={`إنشاء حساب معلم - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/css/intlTelInput.css" />
		<style>
			.iti { width: 100%; direction: ltr; }
			.iti__flag { background-image: url("https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/img/flags.png"); }
			@media (min-resolution: 2x) {
				.iti__flag { background-image: url("https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/img/flags@2x.png"); }
			}
			.iti__country-list { text-align: left; direction: ltr; }
		</style>
	</head>
	<body class="bg-background text-foreground flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-1 container mx-auto px-4 py-12 md:py-20 flex items-center justify-center">
			<div class="w-full max-w-lg">
				<div class="text-center mb-10">
					<h1 class="text-3xl md:text-5xl font-black font-cairo text-gradient mb-4">التسجيل كمعلم</h1>
					<p class="text-muted-foreground font-bold text-lg">انضم لفريق أكاديمية KSA وساهم في تعليم الطلاب.</p>
				</div>

				{error && (
					<div class="bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 p-4 rounded-2xl mb-8 font-bold border border-red-200 dark:border-red-800 text-center">
						حدث خطأ أثناء التسجيل. ربما رقم الجوال مسجل مسبقاً.
					</div>
				)}
				{success && (
					<div class="bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 p-4 rounded-2xl mb-8 font-bold border border-green-200 dark:border-green-800 text-center">
						تم إرسال طلبك بنجاح! سيتم التواصل معك من قبل الإدارة لتفعيل حسابك وتحديد سعر الحصة.
					</div>
				)}

				<div class="bg-card border border-blue-100 dark:border-blue-900/30 rounded-3xl shadow-xl shadow-blue-500/5 p-6 md:p-10 relative overflow-hidden">
					<form action="/api/auth/teacher-register" method="POST" class="space-y-6 relative z-10">
						<div>
							<label for="name" class="block text-sm font-bold text-muted-foreground mb-2">الاسم الثلاثي</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required 
								class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all shadow-sm"
								placeholder="أحمد محمد محمود"
							/>
						</div>

						<div>
							<label for="phone" class="block text-sm font-bold text-muted-foreground mb-2">رقم الجوال</label>
							<input 
								type="tel" 
								id="phone" 
								name="phone" 
								required 
								dir="ltr"
								class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold text-left focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all shadow-sm"
								placeholder="05XXXXXXXX"
							/>
						</div>

            <div>
							<label for="subject" class="block text-sm font-bold text-muted-foreground mb-2">المادة التخصصية</label>
							<input 
								type="text" 
								id="subject" 
								name="subject" 
								required 
								class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all shadow-sm"
								placeholder="رياضيات، قدرات، لغتي..."
							/>
						</div>

						<div>
							<label for="password" class="block text-sm font-bold text-muted-foreground mb-2">كلمة المرور</label>
							<input 
								type="password" 
								id="password" 
								name="password" 
								required 
								dir="ltr"
								class="w-full bg-background border border-input rounded-2xl px-5 py-4 text-base font-bold text-left focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all shadow-sm"
								placeholder="••••••••"
							/>
						</div>

						<button 
							type="submit" 
							class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black text-lg py-4 rounded-2xl shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-1 transition-all duration-300 font-cairo mt-4"
						>
							إرسال طلب الانضمام
						</button>

						<p class="text-center text-muted-foreground mt-6 font-bold text-sm">
							لديك حساب بالفعل؟ <a href="/teacher-login" class="text-blue-600 hover:underline">تسجيل الدخول</a>
						</p>
					</form>
				</div>
			</div>
		</main>

		<Footer />

		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/js/intlTelInput.min.js"></script>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				const input = document.querySelector("#phone");
				if(input) {
					const iti = window.intlTelInput(input, {
						utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/js/utils.js",
						initialCountry: "sa",
						preferredCountries: ["sa", "eg", "ae", "kw", "qa", "bh", "om"],
						separateDialCode: true,
					});

					const form = input.closest('form');
					if(form) {
						form.addEventListener("submit", function(e) {
							if (!iti.isValidNumber()) {
								e.preventDefault();
								alert("رقم الجوال المدخل غير صحيح، يرجى التأكد منه وإعادة المحاولة.");
								return;
							}
							const hiddenPhone = document.createElement("input");
							hiddenPhone.type = "hidden";
							hiddenPhone.name = "phone";
							hiddenPhone.value = iti.getNumber();
							input.removeAttribute("name");
							this.appendChild(hiddenPhone);
						});
					}
				}
			});
		</script>
	</body>
</html>
