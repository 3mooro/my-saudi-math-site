---
export const prerender = false;
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { env } from 'cloudflare:workers';

const { subscription_id } = Astro.params;

const studentCookie = Astro.cookies.get('student_auth')?.value;
const teacherCookie = Astro.cookies.get('teacher_auth')?.value;

if (!studentCookie && !teacherCookie) {
  return Astro.redirect('/login');
}

const db = env.DB;
let role = 'student';
let userId = studentCookie;
if (teacherCookie && !studentCookie) {
  role = 'teacher';
  userId = teacherCookie;
} else if (teacherCookie && studentCookie) {
  // If both cookies exist, determine by which role this user matches the subscription (done in DB query below)
  // For now default to teacher if it matches
}

let title = 'محادثة';
let backUrl = '/student';

if (db) {
  try {
    const sub = await db.prepare(`
      SELECT cs.*, sa.name as student_name, t.name as teacher_name 
      FROM course_subscriptions cs 
      LEFT JOIN student_accounts sa ON cs.student_id = sa.id 
      LEFT JOIN teachers t ON cs.teacher_id = t.id 
      WHERE cs.id = ?
    `).bind(subscription_id).first();

    if (!sub) return Astro.redirect('/');
    
    // Determine exact role if both cookies exist
    if (studentCookie && teacherCookie) {
      if (sub.teacher_id.toString() === teacherCookie) {
        role = 'teacher';
        userId = teacherCookie;
      }
    }

    if (role === 'student' && sub.student_id.toString() !== userId) return Astro.redirect('/student');
    if (role === 'teacher' && sub.teacher_id.toString() !== userId) return Astro.redirect('/teacher');

    backUrl = role === 'student' ? '/student' : '/teacher';
    title = role === 'student' ? `محادثة مع أ. ${sub.teacher_name}` : `محادثة مع الطالب ${sub.student_name}`;
  } catch(e) {
    console.error(e);
  }
}
---

<!doctype html>
<html lang="ar" dir="rtl" class="h-full">
	<head>
		<BaseHead title={`${title} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 text-slate-900 flex flex-col h-[100dvh] overflow-hidden">
		<Header />
		
		<main class="flex-1 container mx-auto px-2 py-2 md:px-4 md:py-8 flex flex-col h-[calc(100dvh-80px)] md:h-[calc(100dvh-100px)]">
      <div class="bg-white border rounded-3xl shadow-sm flex flex-col h-full overflow-hidden">
        
        <!-- Chat Header -->
        <div class="border-b p-3 md:p-4 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <a href={backUrl} class="p-2 hover:bg-slate-200 rounded-full transition-colors text-slate-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-black text-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <h1 class="text-lg md:text-xl font-black">{title}</h1>
          </div>
        </div>

        <!-- Messages Area -->
        <div id="messages-container" class="flex-1 overflow-y-auto p-3 md:p-4 space-y-4 bg-slate-50/30">
          <!-- Messages will be injected here via JS -->
          <div class="flex items-center justify-center h-full">
            <div class="animate-pulse flex items-center gap-2 text-slate-400">
              <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
              جاري تحميل الرسائل...
            </div>
          </div>
        </div>

        <!-- Chat Input -->
        <div class="border-t p-2 md:p-4 bg-white relative pb-4 md:pb-4">
          <!-- Image preview overlay -->
          <div id="image-preview-container" class="hidden absolute bottom-full left-0 m-4 p-2 bg-white border rounded-xl shadow-lg w-40 h-40 group">
            <img id="image-preview" src="" alt="preview" class="w-full h-full object-cover rounded-lg" />
            <button type="button" id="remove-image-btn" class="absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow-sm hover:scale-110 transition-transform">×</button>
          </div>

          <form id="chat-form" class="flex items-end gap-2">
            <label class="p-3 text-slate-400 hover:text-primary hover:bg-primary/5 rounded-2xl cursor-pointer transition-colors flex-shrink-0">
              <input type="file" id="image-input" accept="image/*" class="hidden" />
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </label>
            
            <textarea 
              id="message-input" 
              rows="1"
              placeholder="اكتب رسالتك..." 
              class="flex-1 bg-slate-100 border-none rounded-3xl px-4 py-3 md:px-6 resize-none focus:ring-2 focus:ring-primary focus:bg-white outline-none transition-all scrollbar-hide max-h-32 min-h-[48px] text-base"
            ></textarea>
            
            <button type="submit" id="send-btn" class="bg-primary hover:bg-primary/90 text-primary-foreground p-3 rounded-full shadow-md shadow-primary/25 transition-all flex-shrink-0 disabled:opacity-50">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 -ml-1"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </button>
          </form>
        </div>
      </div>
		</main>

    <script define:vars={{ subscription_id: subscription_id, role: role }}>
      const container = document.getElementById('messages-container');
      const form = document.getElementById('chat-form');
      const msgInput = document.getElementById('message-input');
      const imgInput = document.getElementById('image-input');
      const imgPreviewContainer = document.getElementById('image-preview-container');
      const imgPreview = document.getElementById('image-preview');
      const rmImgBtn = document.getElementById('remove-image-btn');
      const sendBtn = document.getElementById('send-btn');
      
      let base64Image = null;
      let lastMessageCount = 0;

      // Auto-resize textarea
      msgInput.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = (this.scrollHeight) + 'px';
        if (this.value === '') this.style.height = '48px';
      });

      // Handle image selection & compression
      imgInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(event) {
          const img = new Image();
          img.onload = function() {
            // Compress image to save DB size
            const canvas = document.createElement('canvas');
            const MAX_WIDTH = 800;
            let width = img.width;
            let height = img.height;

            if (width > MAX_WIDTH) {
              height = Math.round((height * MAX_WIDTH) / width);
              width = MAX_WIDTH;
            }
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            
            base64Image = canvas.toDataURL('image/jpeg', 0.6); // 60% quality JPEG
            
            imgPreview.src = base64Image;
            imgPreviewContainer.classList.remove('hidden');
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      });

      rmImgBtn.addEventListener('click', () => {
        base64Image = null;
        imgInput.value = '';
        imgPreviewContainer.classList.add('hidden');
      });

      function renderMessages(messages) {
        if (messages.length === lastMessageCount) return; // No new messages
        lastMessageCount = messages.length;

        container.innerHTML = '';
        if (messages.length === 0) {
          container.innerHTML = '<div class="text-center text-slate-400 font-bold mt-10">لا توجد رسائل سابقة. ابدأ المحادثة الآن!</div>';
          return;
        }

        let html = '';
        messages.forEach(msg => {
          const isMine = msg.sender_type === role;
          const utcDateStr = msg.created_at.replace(' ', 'T') + 'Z';
          const time = new Date(utcDateStr).toLocaleTimeString(navigator.language || 'ar-EG', { hour: '2-digit', minute: '2-digit' });

          let messageContent = msg.message ? msg.message.replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" class="text-blue-200 hover:underline" rel="noopener noreferrer" dir="ltr" style="display:inline-block">$1</a>') : '';
          
          if (!isMine && messageContent) {
            messageContent = msg.message.replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" class="text-blue-500 hover:underline" rel="noopener noreferrer" dir="ltr" style="display:inline-block">$1</a>');
          }

          html += `
            <div class="flex flex-col ${isMine ? 'items-end' : 'items-start'}">
              <span class="text-[10px] text-slate-500 font-bold mb-1 px-1">${isMine ? 'أنت' : (role === 'teacher' ? 'الطالب' : 'المعلم')}</span>
              <div class="${isMine ? 'bg-primary text-primary-foreground rounded-tr-sm' : 'bg-white text-slate-800 border rounded-tl-sm shadow-sm'} p-3 rounded-2xl max-w-[85%] md:max-w-[70%]">
                ${msg.image_url ? `<a href="${msg.image_url}" target="_blank"><img src="${msg.image_url}" class="rounded-xl mb-2 max-h-60 object-contain w-full" /></a>` : ''}
                ${messageContent ? `<p class="whitespace-pre-wrap leading-relaxed">${messageContent}</p>` : ''}
              </div>
              <span class="text-[10px] text-slate-400 font-bold mt-1 px-1">${time}</span>
            </div>
          `;
        });
        
        container.innerHTML = html;
        container.scrollTop = container.scrollHeight;
      }

      async function fetchMessages() {
        try {
          const res = await fetch(`/api/chat/${subscription_id}`);
          if (res.ok) {
            const data = await res.json();
            renderMessages(data);
          }
        } catch (e) {
          console.error(e);
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = msgInput.value.trim();
        
        if (!text && !base64Image) return;

        sendBtn.disabled = true;
        sendBtn.innerHTML = '<svg class="animate-spin w-5 h-5 mx-auto text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

        try {
          const res = await fetch(`/api/chat/${subscription_id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, image_url: base64Image })
          });

          if (res.ok) {
            msgInput.value = '';
            msgInput.style.height = '48px';
            rmImgBtn.click();
            await fetchMessages();
          } else {
            const errData = await res.json().catch(() => ({}));
            if (errData.error) {
              alert(errData.error);
            } else {
              alert('حدث خطأ أثناء الإرسال');
            }
          }
        } catch (e) {
          console.error(e);
          alert('حدث خطأ أثناء الإرسال');
        } finally {
          sendBtn.disabled = false;
          sendBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 -ml-1"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';
        }
      });

      // Poll every 3 seconds
      fetchMessages();
      setInterval(fetchMessages, 3000);
    </script>
	</body>
</html>
